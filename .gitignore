# Ignore everything by default.
*

# Repository metadata and documentation.
!/.gitignore
!/README.md
!/LICENSE
!/elegantthesis.cls
!/elegantthesis.sty
!/ThesisInfo.tex

# Thesis source and bibliography.
!/main.tex
!/Bibliography.bib
!/Chapters/
!/Chapters/*.tex
!/Appendix/
!/Appendix/*.tex
!/FrontBackMatter/
!/FrontBackMatter/*.tex

# Figures required by the document.
!/gfx/
!/gfx/*.png

# Repository-specific Copilot guidance.
!/.github/
!/.github/copilot-instructions.md
